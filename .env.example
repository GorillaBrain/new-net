# ============================================================================
# NEW NET — Environment Configuration Example (.env.example)
# ============================================================================
# Copy this file to `.env.local` for local overrides.
# Never commit real API keys, tokens, or database credentials to Git!
#
# NOTE: NEW NET is architected to work out-of-the-box with ZERO external
# credentials by defaulting to its clearly labelled `DEMONSTRATION_ADAPTER`.
# ============================================================================

# Optional: External Supabase / PostgreSQL Persistence Adapter
# When omitted, the backend transparently runs in DEMONSTRATION_ADAPTER mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Optional: Node / Deployment Environment Metadata
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ARCHITECTURE_VERSION=0.9.4-research
